{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "pnpm-workspace",
  "scopeName": "source.pnpm-workspace",
  "fileTypes": ["pnpm-workspace.yaml", "pnpm-workspace.yml"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#keyvalue" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.pnpm-workspace",
      "match": "^\\s*#.*$"
    },
    "keyvalue": {
      "patterns": [
        {
          "match": "^([a-zA-Z][a-zA-Z0-9]*)\\s*(:)\\s*(.*)$",
          "captures": {
            "1": { "name": "keyword.other.key.pnpm-workspace" },
            "2": { "name": "punctuation.separator.key-value.pnpm-workspace" },
            "3": { "name": "string.unquoted.value.pnpm-workspace" }
          }
        },
        {
          "match": "^(\\s+- )(.*)$",
          "captures": {
            "1": { "name": "punctuation.definition.list.pnpm-workspace" },
            "2": { "name": "string.unquoted.value.pnpm-workspace" }
          }
        }
      ]
    }
  }
}
